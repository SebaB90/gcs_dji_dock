# GCS DJI Dock - Frontend Environment Configuration
# 
# For NETWORK ACCESS from other devices:
# 1. Find your server's IP address: hostname -I | awk '{print $1}'
# 2. Copy this file to .env.local
# 3. Replace YOUR_SERVER_IP with your actual IP address
# 4. Restart frontend: ../restart_frontend.sh

# Backend API URL
# Use localhost for same-machine access only
# VITE_BACKEND_URL=http://localhost:8000

# Use your server's IP for network access from other devices
# Example: VITE_BACKEND_URL=http://192.168.1.100:8000
VITE_BACKEND_URL=http://YOUR_SERVER_IP:8000
